# Copia este archivo a backend/.env y completa los valores (NO subas .env a git)
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kg_solutions_dev
# Obligatorio: cadena larga y aleatoria, distinta a la de cualquier otro sistema
JWT_SECRET=
# Opcional: si no se define se usa JWT_SECRET para firmar los enlaces de seguimiento
TRACKING_SECRET=
FRONTEND_URL=http://localhost:5173
TIENDA_URL=http://localhost:5174

# Almacenamiento (en Railway: montar un volumen en /data y usar estas rutas)
# UPLOADS_DIR=/data/uploads
# PRIVATE_UPLOADS_DIR=/data/private_uploads
